# Copy this file to backend/.env and fill in what you have.
# Everything is optional — the app runs fully offline with mock weather data
# and a rule-based assistant fallback if you leave these blank.

# ---- Gemini (multilingual voice assistant + optional text boost) ----
# Powers the real-time voice chat (Assistant tab -> Start Voice Chat) and
# auto-detects/replies in whatever language the user speaks (Hindi, English,
# Bengali, Tamil, Telugu, Marathi, and more). Without it, voice chat shows a
# clear error and falls back automatically to the text assistant, which
# still works via the rule-based fallback.
GEMINI_API_KEY=
# Optional override if Google renames/retires the default Live model.
GEMINI_LIVE_MODEL=

# ---- Weather / environment context ----
OPENWEATHER_API_KEY=
MOCK_CITY=New Delhi

# ---- SOS email alerts (SMTP) ----
# Leave blank to run SOS in "skipped: SMTP not configured" mode (narration
# still works, no email is sent). Gmail example: use smtp.gmail.com:587
# with an App Password (not your normal Gmail password) — see
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Qti pi SOS
